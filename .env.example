# Copie a .env.development o .env.production y ajuste. Sin secretos: todo es publico.

# Base absoluta del API. Vacio (o sin esta variable) = rutas relativas /api,
# que en desarrollo reenvia el proxy de Vite al gateway local (ver vite.config.ts).
# Desarrollo: dejar vacio.
VITE_API_BASE_URL=

# Produccion (valor real en .env.production): el API es el gateway del backend.
# VITE_API_BASE_URL=https://api.taminaka.com
